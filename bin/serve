#!/bin/sh
# Serve the reader from this Mac to the home Wi-Fi.
# Usage: bin/serve [folder-with-pdfs] [port]
set -eu

here=$(cd "$(dirname "$0")/.." && pwd)
pdf_dir=${1:-}
port=${2:-8000}

if [ -n "$pdf_dir" ]; then
  pdf_dir=$(cd "$pdf_dir" && pwd)
fi

name=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
echo "On the iPad, open: http://$name.local:$port/"
[ -n "$pdf_dir" ] && echo "PDFs from: $pdf_dir"
echo "Certificate: http://$name.local:$port/isrgrootx1.der"
echo "Stop with Ctrl-C."

PDF_DIR=$pdf_dir exec php -S "0.0.0.0:$port" -t "$here" "$here/bin/router.php"
